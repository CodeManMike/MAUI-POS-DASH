<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MAUI_POS_DASH.MAUI_Android.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MAUI_POS_DASH.MAUI_Android.ViewModels"
    xmlns:domain="clr-namespace:MAUI_POS_DASH.Core.Domain;assembly=MAUI-POS-DASH.Core"
    x:Name="PageRoot"
    x:DataType="vm:LoginViewModel"
    Title="Attendant Login">

    <ScrollView>
        <VerticalStackLayout Padding="20,28" Spacing="20">

            <Label Text="Attendant Login" Style="{StaticResource PageTitle}" />

            <CollectionView
                ItemsSource="{Binding Attendants}"
                IsVisible="{Binding IsAttendantGrid}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="12" HorizontalItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="domain:Attendant">
                        <Button
                            Text="{Binding Name}"
                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectAttendantCommand}"
                            CommandParameter="{Binding .}"
                            Style="{StaticResource NavTile}"
                            HeightRequest="72" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border Style="{StaticResource Card}" IsVisible="{Binding IsPinEntry}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{Binding SelectedAttendant.Name, StringFormat='Signing in as {0}'}" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldFrame}">
                        <Entry
                            Text="{Binding Pin}"
                            Placeholder="Enter PIN"
                            IsPassword="True"
                            MaxLength="6"
                            Keyboard="Numeric" />
                    </Border>
                    <Button Text="Sign in" Command="{Binding SubmitPinCommand}" />
                    <Button Text="Back" Command="{Binding BackCommand}" Style="{StaticResource SecondaryButton}" />
                </VerticalStackLayout>
            </Border>

            <Label
                Text="{Binding ErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                IsVisible="{Binding HasError}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
