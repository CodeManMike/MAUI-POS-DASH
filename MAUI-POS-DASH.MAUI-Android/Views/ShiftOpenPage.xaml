<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MAUI_POS_DASH.MAUI_Android.Views.ShiftOpenPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MAUI_POS_DASH.MAUI_Android.ViewModels"
    xmlns:views="clr-namespace:MAUI_POS_DASH.MAUI_Android.Views"
    x:DataType="vm:ShiftOpenViewModel"
    Title="Open Shift">

    <Grid RowDefinitions="Auto,*">
        <views:StatusHeaderView Grid.Row="0" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,24" Spacing="18">
                <Label Text="Open Shift" Style="{StaticResource PageTitle}" />

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Opening float" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource FieldFrame}">
                            <Entry
                                Text="{Binding OpeningFloat}"
                                Placeholder="0.00"
                                Keyboard="Numeric" />
                        </Border>
                        <Button Text="Open Shift" Command="{Binding OpenShiftCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Label
                    Text="{Binding ErrorMessage}"
                    Style="{StaticResource ErrorLabel}"
                    IsVisible="{Binding HasError}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
