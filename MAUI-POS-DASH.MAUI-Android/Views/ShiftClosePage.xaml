<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MAUI_POS_DASH.MAUI_Android.Views.ShiftClosePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MAUI_POS_DASH.MAUI_Android.ViewModels"
    xmlns:views="clr-namespace:MAUI_POS_DASH.MAUI_Android.Views"
    x:DataType="vm:ShiftCloseViewModel"
    Title="Close Shift">

    <Grid RowDefinitions="Auto,*">
        <views:StatusHeaderView Grid.Row="0" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,24" Spacing="18">
                <Label Text="Close Shift" Style="{StaticResource PageTitle}" />

                <Label
                    Text="{Binding NoShiftMessage}"
                    Style="{StaticResource Subtext}"
                    IsVisible="{Binding NoOpenShift}" />

                <Border Style="{StaticResource Card}" IsVisible="{Binding IsCounting}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Cash counted" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource FieldFrame}">
                            <Entry
                                Text="{Binding CashCounted}"
                                Placeholder="0.00"
                                Keyboard="Numeric" />
                        </Border>
                        <Button Text="Review" Command="{Binding ReviewCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" IsVisible="{Binding IsReviewing}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding Reconciliation.ExpectedCash, StringFormat='Expected cash: R{0}'}" Style="{StaticResource Subtext}" />
                        <Label Text="{Binding Reconciliation.CountedCash, StringFormat='Counted cash: R{0}'}" Style="{StaticResource Subtext}" />
                        <Label Text="{Binding Reconciliation.Variance, StringFormat='Variance: R{0}'}" Style="{StaticResource AmountDisplay}" />
                        <Label Text="{Binding ToleranceStatus}" Style="{StaticResource FieldLabel}" />
                        <Button Text="Confirm Close" Command="{Binding ConfirmCloseCommand}" />
                        <Button Text="Recount" Command="{Binding RecountCommand}" Style="{StaticResource SecondaryButton}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
