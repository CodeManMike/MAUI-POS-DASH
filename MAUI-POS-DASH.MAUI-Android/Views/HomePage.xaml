<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MAUI_POS_DASH.MAUI_Android.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MAUI_POS_DASH.MAUI_Android.ViewModels"
    xmlns:views="clr-namespace:MAUI_POS_DASH.MAUI_Android.Views"
    x:DataType="vm:HomeViewModel"
    Title="Forecourt Terminal">

    <VerticalStackLayout Padding="24" Spacing="16">
        <views:StatusHeaderView />

        <Label Text="Forecourt Terminal" FontSize="24" FontAttributes="Bold" />

        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
            <Button Grid.Row="0" Grid.Column="0" Text="Fleet Card" Command="{Binding GoToFleetCardCommand}" />
            <Button Grid.Row="0" Grid.Column="1" Text="Mobile Money" Command="{Binding GoToMobileMoneyCommand}" />
            <Button Grid.Row="1" Grid.Column="0" Text="Cash" Command="{Binding GoToCashCommand}" />
            <Button Grid.Row="1" Grid.Column="1" Text="Attendants" Command="{Binding GoToAttendantsCommand}" />
            <Button Grid.Row="2" Grid.Column="0" Text="Open Shift" Command="{Binding GoToOpenShiftCommand}" />
            <Button Grid.Row="2" Grid.Column="1" Text="Close Shift" Command="{Binding GoToCloseShiftCommand}" />
        </Grid>
    </VerticalStackLayout>
</ContentPage>
