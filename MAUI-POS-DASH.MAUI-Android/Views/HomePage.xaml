<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MAUI_POS_DASH.MAUI_Android.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MAUI_POS_DASH.MAUI_Android.ViewModels"
    xmlns:views="clr-namespace:MAUI_POS_DASH.MAUI_Android.Views"
    x:DataType="vm:HomeViewModel"
    Title="Forecourt Terminal">

    <Grid RowDefinitions="Auto,*">
        <views:StatusHeaderView Grid.Row="0" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,24" Spacing="18">
                <Label Text="Forecourt Terminal" Style="{StaticResource PageTitle}" />

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="14">
                    <Button Grid.Row="0" Grid.Column="0" Text="Fleet Card" Command="{Binding GoToFleetCardCommand}" Style="{StaticResource NavTile}" />
                    <Button Grid.Row="0" Grid.Column="1" Text="Mobile Money" Command="{Binding GoToMobileMoneyCommand}" Style="{StaticResource NavTile}" />
                    <Button Grid.Row="1" Grid.Column="0" Text="Cash" Command="{Binding GoToCashCommand}" Style="{StaticResource NavTile}" />
                    <Button Grid.Row="1" Grid.Column="1" Text="Attendants" Command="{Binding GoToAttendantsCommand}" Style="{StaticResource NavTile}" />
                    <Button Grid.Row="2" Grid.Column="0" Text="Open Shift" Command="{Binding GoToOpenShiftCommand}" Style="{StaticResource NavTile}" />
                    <Button Grid.Row="2" Grid.Column="1" Text="Close Shift" Command="{Binding GoToCloseShiftCommand}" Style="{StaticResource NavTile}" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
