<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MAUI_POS_DASH.MAUI_Android.Views.AttendantManagementPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MAUI_POS_DASH.MAUI_Android.ViewModels"
    xmlns:views="clr-namespace:MAUI_POS_DASH.MAUI_Android.Views"
    xmlns:domain="clr-namespace:MAUI_POS_DASH.Core.Domain;assembly=MAUI-POS-DASH.Core"
    x:Name="PageRoot"
    x:DataType="vm:AttendantManagementViewModel"
    Title="Attendants">

    <Grid RowDefinitions="Auto,*">
        <views:StatusHeaderView Grid.Row="0" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,24" Spacing="18">
                <Label Text="Attendants" Style="{StaticResource PageTitle}" />

                <Label
                    Text="Managers only — you don't have access to this page."
                    Style="{StaticResource Subtext}"
                    IsVisible="{Binding IsUnauthorized}" />

                <VerticalStackLayout IsVisible="{Binding IsAuthorized}" Spacing="18">

                    <CollectionView ItemsSource="{Binding Attendants}" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="domain:Attendant">
                                <Border Style="{StaticResource ListRow}">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" />
                                            <Label Text="{Binding Role}" Style="{StaticResource FieldLabel}" />
                                        </VerticalStackLayout>
                                        <Button
                                            Grid.Column="1"
                                            Text="Edit"
                                            Style="{StaticResource ListActionButton}"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.EditCommand}"
                                            CommandParameter="{Binding .}" />
                                        <Button
                                            Grid.Column="2"
                                            Text="Deactivate"
                                            Style="{StaticResource ListActionButton}"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeactivateCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="14">
                            <Label Text="{Binding FormTitle}" Style="{StaticResource PageTitle}" FontSize="18" />

                            <Border Style="{StaticResource FieldFrame}">
                                <Entry Text="{Binding FormName}" Placeholder="Name" />
                            </Border>

                            <Border Style="{StaticResource FieldFrame}">
                                <Picker ItemsSource="{Binding Roles}" SelectedItem="{Binding FormRole}" />
                            </Border>

                            <Border Style="{StaticResource FieldFrame}">
                                <Entry
                                    Text="{Binding FormPin}"
                                    Placeholder="{Binding PinLabel}"
                                    IsPassword="True"
                                    MaxLength="6"
                                    Keyboard="Numeric" />
                            </Border>

                            <Button Text="Save" Command="{Binding SaveCommand}" />
                            <Button Text="Cancel" Command="{Binding ResetFormCommand}" Style="{StaticResource SecondaryButton}" IsVisible="{Binding IsEditing}" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

                <Label
                    Text="{Binding ErrorMessage}"
                    Style="{StaticResource ErrorLabel}"
                    IsVisible="{Binding HasError}" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
