<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MAUI_POS_DASH.MAUI_Android.Views.AttendantManagementPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MAUI_POS_DASH.MAUI_Android.ViewModels"
    xmlns:views="clr-namespace:MAUI_POS_DASH.MAUI_Android.Views"
    xmlns:domain="clr-namespace:MAUI_POS_DASH.Core.Domain;assembly=MAUI-POS-DASH.Core"
    x:Name="PageRoot"
    x:DataType="vm:AttendantManagementViewModel"
    Title="Attendants">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <views:StatusHeaderView />

            <Button Text="Back to terminal home" Command="{Binding GoToHomeCommand}" />

            <Label Text="Attendants" FontSize="24" FontAttributes="Bold" />

            <VerticalStackLayout IsVisible="{Binding IsUnauthorized}" Spacing="12">
                <Label Text="Managers only — you don't have access to this page." />
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding IsAuthorized}" Spacing="16">

                <CollectionView ItemsSource="{Binding Attendants}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="domain:Attendant">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Padding="0,6">
                                <Label Grid.Column="0" Text="{Binding Name}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding Role}" VerticalOptions="Center" />
                                <Button
                                    Grid.Column="2"
                                    Text="Edit"
                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.EditCommand}"
                                    CommandParameter="{Binding .}" />
                                <Button
                                    Grid.Column="3"
                                    Text="Deactivate"
                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeactivateCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="{Binding FormTitle}" FontSize="18" FontAttributes="Bold" />

                <Entry Text="{Binding FormName}" Placeholder="Name" />

                <Picker ItemsSource="{Binding Roles}" SelectedItem="{Binding FormRole}" />

                <Entry
                    Text="{Binding FormPin}"
                    Placeholder="{Binding PinLabel}"
                    IsPassword="True"
                    MaxLength="6"
                    Keyboard="Numeric" />

                <Button Text="Save" Command="{Binding SaveCommand}" />
                <Button Text="Cancel" Command="{Binding ResetFormCommand}" IsVisible="{Binding IsEditing}" />

            </VerticalStackLayout>

            <Label
                Text="{Binding ErrorMessage}"
                TextColor="Red"
                IsVisible="{Binding HasError}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
