<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MAUI_POS_DASH.MAUI_Android.Views.MobileMoneySalePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MAUI_POS_DASH.MAUI_Android.ViewModels"
    xmlns:views="clr-namespace:MAUI_POS_DASH.MAUI_Android.Views"
    x:DataType="vm:MobileMoneySaleViewModel"
    Title="Mobile Money">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <views:StatusHeaderView />

            <Label Text="Mobile Money" FontSize="24" FontAttributes="Bold" />

            <Label Text="{Binding NoShiftMessage}" TextColor="Red">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding NoShiftMessage}" Value="{x:Null}">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <VerticalStackLayout Spacing="16">
                <VerticalStackLayout.Triggers>
                    <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding CurrentShift}" Value="{x:Null}">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </VerticalStackLayout.Triggers>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsInputForm}">
                    <Entry
                        Text="{Binding Amount}"
                        Placeholder="Amount"
                        Keyboard="Numeric" />

                    <Button Text="Request Payment" Command="{Binding ProcessSaleCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Text" Value="Waiting for customer confirmation…" />
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <Label
                        Text="{Binding ErrorMessage}"
                        TextColor="Red"
                        IsVisible="{Binding HasError}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsResult}">
                    <Label Text="{Binding Result.DetailMessage}" />

                    <Label Text="{Binding Result.Sale.Id, StringFormat='Sale {0}'}" IsVisible="{Binding IsConfirmed}" />
                    <Label Text="{Binding Result.Transaction.Amount, StringFormat='Amount R{0:0.00}'}" IsVisible="{Binding IsConfirmed}" />

                    <Button Text="Take Another Payment" Command="{Binding ResetCommand}" />
                </VerticalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
