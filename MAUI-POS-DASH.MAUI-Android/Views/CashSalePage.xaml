<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MAUI_POS_DASH.MAUI_Android.Views.CashSalePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MAUI_POS_DASH.MAUI_Android.ViewModels"
    xmlns:views="clr-namespace:MAUI_POS_DASH.MAUI_Android.Views"
    x:DataType="vm:CashSaleViewModel"
    Title="Cash Sale">

    <Grid RowDefinitions="Auto,*">
        <views:StatusHeaderView Grid.Row="0" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,24" Spacing="18">
                <Label Text="Cash Sale" Style="{StaticResource PageTitle}" />

                <Label
                    Text="{Binding NoShiftMessage}"
                    Style="{StaticResource Subtext}"
                    IsVisible="{Binding NoOpenShift}" />

                <Border Style="{StaticResource Card}" IsVisible="{Binding IsInputForm}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Amount owed" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource FieldFrame}">
                            <Entry Text="{Binding AmountOwed}" Placeholder="0.00" Keyboard="Numeric" />
                        </Border>

                        <Label Text="Cash tendered" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource FieldFrame}">
                            <Entry Text="{Binding AmountTendered}" Placeholder="0.00" Keyboard="Numeric" />
                        </Border>

                        <Button Text="Take Payment" Command="{Binding ProcessSaleCommand}" />

                        <Label
                            Text="{Binding ErrorMessage}"
                            Style="{StaticResource ErrorLabel}"
                            IsVisible="{Binding HasError}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" IsVisible="{Binding HasResult}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding Result.Change, StringFormat='Change due: R{0}'}" Style="{StaticResource AmountDisplay}" />
                        <Label Text="{Binding Result.Sale.Id, StringFormat='Sale {0}'}" Style="{StaticResource Subtext}" />
                        <Label Text="{Binding Result.Transaction.Amount, StringFormat='R{0}'}" Style="{StaticResource Subtext}" />
                        <Button Text="Take Another Payment" Command="{Binding ResetCommand}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
