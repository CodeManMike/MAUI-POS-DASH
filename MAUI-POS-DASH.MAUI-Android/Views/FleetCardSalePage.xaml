<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MAUI_POS_DASH.MAUI_Android.Views.FleetCardSalePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MAUI_POS_DASH.MAUI_Android.ViewModels"
    xmlns:views="clr-namespace:MAUI_POS_DASH.MAUI_Android.Views"
    x:DataType="vm:FleetCardSaleViewModel"
    Title="Fleet Card">

    <Grid RowDefinitions="Auto,*">
        <views:StatusHeaderView Grid.Row="0" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,24" Spacing="18">
                <Label Text="Fleet Card" Style="{StaticResource PageTitle}" />

                <Label
                    Text="{Binding NoShiftMessage}"
                    Style="{StaticResource Subtext}"
                    IsVisible="{Binding NoOpenShift}" />

                <Border Style="{StaticResource Card}" IsVisible="{Binding IsInputForm}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Amount" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource FieldFrame}">
                            <Entry Text="{Binding Amount}" Placeholder="0.00" Keyboard="Numeric" />
                        </Border>
                        <Button
                            Text="{Binding ProcessButtonText}"
                            Command="{Binding ProcessSaleCommand}"
                            IsEnabled="{Binding CanTakePayment}" />
                        <Label
                            Text="{Binding ErrorMessage}"
                            Style="{StaticResource ErrorLabel}"
                            IsVisible="{Binding HasError}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" IsVisible="{Binding IsResultView}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding Result.DetailMessage}" Style="{StaticResource Subtext}" />
                        <Label
                            Text="{Binding Result.Transaction.Amount, StringFormat='R{0:0.00}'}"
                            Style="{StaticResource AmountDisplay}"
                            IsVisible="{Binding IsApproved}" />
                        <Label
                            Text="{Binding Result.Sale.Id, StringFormat='Sale {0}'}"
                            Style="{StaticResource Subtext}"
                            IsVisible="{Binding IsApproved}" />
                        <Button Text="Take Another Payment" Command="{Binding ResetCommand}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
