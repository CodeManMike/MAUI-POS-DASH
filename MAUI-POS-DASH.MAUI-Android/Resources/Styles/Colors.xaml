<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        A petrol/teal tonal palette instead of the default MAUI-template purple — it reads as a
        forecourt terminal (pump signage, register displays) rather than a generic scaffold. Named
        as Material-style roles (Surface/OnSurface/Container/etc.) so Styles.xaml can express intent
        ("this is a container fill", "this is text on that fill") instead of picking greys by number.
    -->

    <!-- Light -->
    <Color x:Key="Primary">#0E6E5C</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="PrimaryContainer">#B6F0DF</Color>
    <Color x:Key="OnPrimaryContainer">#00201A</Color>
    <Color x:Key="Surface">#FAFDFB</Color>
    <Color x:Key="SurfaceVariant">#E3EEE9</Color>
    <Color x:Key="OnSurface">#171D1B</Color>
    <Color x:Key="OnSurfaceVariant">#3F4946</Color>
    <Color x:Key="Outline">#6F7975</Color>
    <Color x:Key="OutlineVariant">#C1CBC6</Color>
    <Color x:Key="Background">#F3F6F5</Color>
    <Color x:Key="Error">#BA1A1A</Color>
    <Color x:Key="OnError">#FFFFFF</Color>
    <Color x:Key="ErrorContainer">#FFDAD6</Color>
    <Color x:Key="Disabled">#C1CBC6</Color>
    <Color x:Key="OnDisabled">#6F7975</Color>

    <!-- Dark -->
    <Color x:Key="PrimaryDark">#5BDBBC</Color>
    <Color x:Key="OnPrimaryDark">#00382E</Color>
    <Color x:Key="PrimaryContainerDark">#005142</Color>
    <Color x:Key="OnPrimaryContainerDark">#7BF8D8</Color>
    <Color x:Key="SurfaceDark">#0F1512</Color>
    <Color x:Key="SurfaceVariantDark">#3F4946</Color>
    <Color x:Key="OnSurfaceDark">#DEE4E0</Color>
    <Color x:Key="OnSurfaceVariantDark">#BEC9C4</Color>
    <Color x:Key="OutlineDark">#899490</Color>
    <Color x:Key="OutlineVariantDark">#3F4946</Color>
    <Color x:Key="BackgroundDark">#0B100D</Color>
    <Color x:Key="ErrorDark">#FFB4AB</Color>
    <Color x:Key="OnErrorDark">#690005</Color>
    <Color x:Key="ErrorContainerDark">#93000A</Color>
    <Color x:Key="DisabledDark">#3F4946</Color>
    <Color x:Key="OnDisabledDark">#899490</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>

    <SolidColorBrush x:Key="ShadowBrush" Color="#330F1512" />

</ResourceDictionary>
